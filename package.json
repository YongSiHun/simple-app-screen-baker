{
  "name": "simple-app-screen-baker",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node scripts/setup-git-hooks.mjs && node scripts/prepare-fonts.mjs && vite --host 0.0.0.0",
